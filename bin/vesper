#!/bin/sh
# Vesper Relay launcher: finds a Python 3.11+ and runs vesper.py from this checkout, so users
# never need a virtual environment. The installed `vesper` command (vesper.py install) runs
# this file, and so will the Claude Code plugin (P5-T2). POSIX sh; macOS and Linux.
#
# Search order: $VESPER_PYTHON (the installer records the Python it ran with), python3.14
# down to python3.11, python3, then python3 in $VESPER_PYTHON_DIRS (default: the Homebrew
# bins, for apps that start without a login PATH), then `uv python find`.
# With no Python 3.11+, `vesper setup` offers to install one (Homebrew or uv); every other
# command says how.

# Only shell builtins below (no dirname, cat or uname): PATH may hold nothing else.
case "$0" in */*) BIN=${0%/*} ;; *) BIN=. ;; esac
HERE=$(cd "$BIN/.." && pwd -P) || exit 2

supported() {
    "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1
}

find_python() {
    for candidate in "${VESPER_PYTHON:-}" python3.14 python3.13 python3.12 python3.11 python3; do
        [ -n "$candidate" ] || continue
        found=$(command -v "$candidate" 2>/dev/null) || continue
        if supported "$found"; then echo "$found"; return 0; fi
    done
    for dir in ${VESPER_PYTHON_DIRS-/opt/homebrew/bin /usr/local/bin}; do
        if [ -x "$dir/python3" ] && supported "$dir/python3"; then echo "$dir/python3"; return 0; fi
    done
    if command -v uv >/dev/null 2>&1; then
        found=$(uv python find '>=3.11' 2>/dev/null) && [ -n "$found" ] && supported "$found" &&
            { echo "$found"; return 0; }
    fi
    return 1
}

install_command() {
    if command -v brew >/dev/null 2>&1; then echo "brew install python@3.12"
    elif command -v uv >/dev/null 2>&1; then echo "uv python install 3.12"
    fi
}

if PYTHON=$(find_python); then
    exec "$PYTHON" -B "$HERE/vesper.py" "$@"
fi

offer=$(install_command)
if [ "${1:-}" = "setup" ] && [ -n "$offer" ]; then
    printf 'vesper: Vesper needs Python 3.11 or newer and none was found.\nInstall it now with `%s`? [y/N]: ' "$offer"
    read -r answer || answer=""
    case "$answer" in
        y|Y|yes|YES)
            $offer || { echo "vesper: \`$offer\` failed" >&2; exit 2; }
            if PYTHON=$(find_python); then exec "$PYTHON" -B "$HERE/vesper.py" "$@"; fi
            echo "vesper: Python was installed but is not on PATH yet; open a new terminal and run vesper setup again" >&2
            exit 2 ;;
    esac
fi

{
    echo "vesper: no Python 3.11 or newer found (tried \$VESPER_PYTHON, python3.14 to python3.11, python3)."
    echo "Run \`vesper setup\` to install one${offer:+ (it offers: $offer)}, or install it yourself:"
    echo "  macOS:          brew install python@3.12   (Homebrew: https://brew.sh)"
    echo "  Debian/Ubuntu:  sudo apt install python3.12"
    echo "  Fedora:         sudo dnf install python3.12"
    echo "  Any OS:         uv python install 3.12     (https://docs.astral.sh/uv/)"
} >&2
exit 2
